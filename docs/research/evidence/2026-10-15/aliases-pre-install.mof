	Name = "BootOptionOnWatchDog";
	Qualifiers = {
instance of MSFT_CliQualifier
{
	Name = "Values";
	QualifierValue = {"Reserved", "Operating system", "System utilities", "Do not reboot"};
}};
}, 
instance of MSFT_CliProperty
{
