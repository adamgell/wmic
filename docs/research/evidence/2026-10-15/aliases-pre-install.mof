instance of MSFT_CliVerb
{
	Derivation = "TakeOwnerShip";
	Description = "The TakeOwnerShip method obtains ownership of the logical file specified in the object path . If the logical file is actually a directory, then TakeOwnerShip will act recursively, taking ownership of all the files and sub-directories the directory contain";
