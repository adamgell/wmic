	Qualifiers = {
instance of MSFT_CliQualifier
{
	Name = "ValueMap";
	QualifierValue = {"1", "2", "3", "4", "5"};
}, 
instance of MSFT_CliQualifier
{
	Name = "Values";
	QualifierValue = {"Other", "Unknown", "None", "External interface locked out", "External interface enabled"};
}};
}, 
