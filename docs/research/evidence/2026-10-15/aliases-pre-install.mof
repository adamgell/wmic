	FriendlyName = "NICConfig";
	PWhere = "Where Index=#";
	Target = "Select * from Win32_NetworkAdapterConfiguration";
	Verbs = {
instance of MSFT_CliVerb
{
	Derivation = "ipconfig /FlushDns";
