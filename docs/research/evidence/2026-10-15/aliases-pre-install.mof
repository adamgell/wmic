	Qualifiers = {
instance of MSFT_CliQualifier
{
	Name = "Description";
	QualifierValue = {"This method is used schedule chkdsk to be run at the next reboot if the dirty bit has been set.  The method is applicable to only those instances of logical disk that represent a physical disk in the machine. It is not applicable to mapped logical drives."};
