	QualifierValue = {"True"};
}};
	Type = "UINT8";
}, 
instance of MSFT_CliParam
{
	ParaId = "LoadOrderGroup";
	Qualifiers = {
instance of MSFT_CliQualifier
{
	Name = "In";
	QualifierValue = {"True"};
}};
	Type = "STRING";
}, 
instance of MSFT_CliParam
{
	ParaId = "LoadOrderGroupDependencies";
	Qualifiers = {
instance of MSFT_CliQualifier
{
	Name = "In";
	QualifierValue = {"True"};
}};
	Type = "ARRAY OF STRING";
}, 
instance of MSFT_CliParam
{
	ParaId = "Name";
	Qualifiers = {
instance of MSFT_CliQualifier
{
	Name = "In";
	QualifierValue = {"True"};
}};
	Type = "STRING";
}, 
instance of MSFT_CliParam
{
	ParaId = "PathName";
	Qualifiers = {
instance of MSFT_CliQualifier
