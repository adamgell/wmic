instance of MSFT_CliProperty
{
	Derivation = "SupportsMulticasting";
	Description = "The SupportsMulticasting property indicates whether the protocol supports multicasting.";
	Name = "SupportsMulticasting";
}, 
instance of MSFT_CliProperty
