{
	Locale = "ms_409";
	NameSpace = "ROOT\\CIMV2";
	Server = ".";
};
	Description = "The Win32_LogonSession class describes the logon session or sessions associated with a user who has logged on to Windows NT or Windows 2000.";
	Formats = {
instance of MSFT_CliFormat
{
	Name = "INSTANCE";
	Properties = {
instance of MSFT_CliProperty
{
	Derivation = "__PATH";
	Name = "__PATH";
