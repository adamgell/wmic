	FriendlyName = "Volume";
	PWhere = " Where DeviceID = '#'";
	Target = "Select * from Win32_Volume";
	Verbs = {
instance of MSFT_CliVerb
{
	Derivation = "Chkdsk";
	Description = "This method invokes the chkdsk operation on the volume. The method is applicable to only those volume instances that represent a physical disk in the machine. It is not applicable to mapped logical drives.";
	Name = "Chkdsk";
	Parameters = {
instance of MSFT_CliParam
{
	Description = "This parameter indicates what should be done to errors found on the disk. If true, then errors are fixed.";
	ParaId = "FixErrors";
	Qualifiers = {
instance of MSFT_CliQualifier
{
	Name = "In";
	QualifierValue = {"True"};
}};
	Type = "BOOLEAN";
}, 
instance of MSFT_CliParam
{
	Description = "This parameter indicates whether the volume should be forced to dismount before checking.";
	ParaId = "ForceDismount";
	Qualifiers = {
instance of MSFT_CliQualifier
{
	Name = "In";
	QualifierValue = {"True"};
}};
	Type = "BOOLEAN";
}, 
instance of MSFT_CliParam
{
	Description = "This parameter indicates whether the chkdsk operation should be performed at next boot up time, in case the operation could not be performed because the disk was locked at time the method was called.";
	ParaId = "OkToRunAtBootUp";
	Qualifiers = {
instance of MSFT_CliQualifier
{
	Name = "In";
	QualifierValue = {"True"};
}};
	Type = "BOOLEAN";
}, 
instance of MSFT_CliParam
{
	Description = "This parameter indicates whether the bad sectors should be located and the readable information should be recovered from these sectors.";
	ParaId = "RecoverBadSectors";
	Qualifiers = {
instance of MSFT_CliQualifier
{
	Name = "In";
	QualifierValue = {"True"};
}};
	Type = "BOOLEAN";
}, 
instance of MSFT_CliParam
{
	Description = "This parameter indicates whether the folder cycle checking should be skipped or not.";
	ParaId = "SkipFolderCycle";
	Qualifiers = {
instance of MSFT_CliQualifier
{
	Name = "In";
	QualifierValue = {"True"};
}};
	Type = "BOOLEAN";
}, 
instance of MSFT_CliParam
{
	Description = "This parameter indicates whether a vigorous check of index entries should be performed.";
	ParaId = "VigorousIndexCheck";
	Qualifiers = {
instance of MSFT_CliQualifier
{
	Name = "In";
	QualifierValue = {"True"};
}};
	Type = "BOOLEAN";
}};
	Qualifiers = {
instance of MSFT_CliQualifier
{
	Name = "Values";
	QualifierValue = {"Success", "Success - Volume locked and chkdsk scheduled on reboot", "Unsupported file system", "Unknown file system", "No media in drive", "Unknown error"};
}};
	Usage = "Chkdsk";
}, 
instance of MSFT_CliVerb
{
	Derivation = "ScheduleAutoChk";
	Description = "This method is used schedule chkdsk to be run at the next reboot if the dirty bit has been set.The method is applicable to only those volume instances that represent a physical disk in the machine. It is not applicable to mapped logical drives. ";
	Name = "ScheduleAutoChk";
	Parameters = {
instance of MSFT_CliParam
{
	Description = "This parameter is used to specify the list of volumes that should be scheduled for autochk at next reboot. The string syntax consists of the the drive letter, mount point name, or volume GUID name for the volume.";
	ParaId = "Volume";
	Qualifiers = {
instance of MSFT_CliQualifier
{
	Name = "In";
	QualifierValue = {"True"};
}};
	Type = "ARRAY OF STRING";
}};
	Qualifiers = {
instance of MSFT_CliQualifier
{
	Name = "Values";
	QualifierValue = {"Success", "Remote Drive", "Removable Drive", "Drive Not Root Directory", "Unknown Drive"};
}};
	Usage = "ScheduleAutoChk";
}, 
instance of MSFT_CliVerb
{
	Derivation = "ExcludeFromAutoChk";
	Description = "This method is used to exclude volumes from the chkdsk operation to be run at the next reboot. If not excluded, chkdsk is performed on the volume if the dirty bit has been set for the disk. Note that the calls to exclude volumes are not cumulative.";
	Name = "ExcludeFromAutoChk";
	Parameters = {
instance of MSFT_CliParam
{
	Description = "This parameter is used to specify the list of volumes that should be excluded from autochk at next reboot. The string syntax consists of the the drive letter followed by a colon for the logical disk.";
	ParaId = "Volume";
	Qualifiers = {
instance of MSFT_CliQualifier
{
	Name = "In";
	QualifierValue = {"True"};
}};
	Type = "ARRAY OF STRING";
}};
	Qualifiers = {
instance of MSFT_CliQualifier
{
	Name = "Values";
	QualifierValue = {"Success", "Remote Drive", "Removable Drive", "Drive Not Root Directory", "Unknown Drive"};
}};
	Usage = "ExcludeFromAutoChk";
}, 
instance of MSFT_CliVerb
{
	Derivation = "Format";
	Description = "This method is used to format the volume.";
	Name = "Format";
	Parameters = {
instance of MSFT_CliParam
{
	Description = "Specifies the disk allocation unit size or cluster size. All file systems used by this version of Windows organize your hard disk based on cluster size, which represents the smallest amount of disk space that can be allocated to hold a file. The smaller the cluster size you use, the more efficiently your disk stores information. If no cluster size is specified during format, Windows picks defaults based on the size of the volume. These defaults have been selected to reduce the amount of space lost and to reduce the amount of fragmentation on the volume. For general use, default settings are strongly recommended.";
	ParaId = "ClusterSize";
	Qualifiers = {
instance of MSFT_CliQualifier
{
	Name = "In";
	QualifierValue = {"True"};
}};
	Type = "UINT32";
}, 
instance of MSFT_CliParam
{
	Description = "Indicates if the volume should be enabled for compression";
	ParaId = "EnableCompression";
	Qualifiers = {
instance of MSFT_CliQualifier
{
	Name = "In";
	QualifierValue = {"True"};
}};
	Type = "BOOLEAN";
}, 
instance of MSFT_CliParam
{
	Description = "The file system format to use for the volume.";
	ParaId = "FileSystem";
	Qualifiers = {
instance of MSFT_CliQualifier
{
	Name = "ValueMap";
	QualifierValue = {"0", "1", "2"};
}, 
instance of MSFT_CliQualifier
{
	Name = "Values";
	QualifierValue = {"NTFS", "FAT32", "FAT"};
}, 
instance of MSFT_CliQualifier
{
	Name = "In";
	QualifierValue = {"True"};
}};
	Type = "STRING";
}, 
instance of MSFT_CliParam
{
	Description = "The label to use for the new volume.  The volume label can contain up to 11 characters for FAT and FAT32 volumes or up to 32 characters for NTFS volumes.";
	ParaId = "Label";
	Qualifiers = {
instance of MSFT_CliQualifier
{
	Name = "In";
	QualifierValue = {"True"};
}};
	Type = "STRING";
}, 
instance of MSFT_CliParam
{
	Description = "Specifies whether to perform a quick format by removing files from the disk without scanning the disk for bad sectors. Use this option only if this disk has been previously formatted and you are sure the disk is not damaged.";
	ParaId = "QuickFormat";
	Qualifiers = {
instance of MSFT_CliQualifier
{
	Name = "In";
	QualifierValue = {"True"};
}};
	Type = "BOOLEAN";
}};
	Qualifiers = {
instance of MSFT_CliQualifier
{
	Name = "Values";
	QualifierValue = {"Success", "Unsupported file system", "Incompatible media in drive", "Access denied", "Call cancelled", "Call cancellation request too late", "Volume write protected", "Volume lock failed", "Unable to quick format", "Input/Output error", "Invalid volume label", "No media in drive", "Volume is too small", "Volume is too large", "Volume is not mounted", "Cluster size is too small", "Cluster size is too large", "Cluster size is beyond 32 bits", "Unknown error"};
}};
	Usage = "Format";
}, 
instance of MSFT_CliVerb
{
	Derivation = "Defrag";
	Description = "This method is used to defrag the volume.";
	Name = "Defrag";
	Parameters = {
instance of MSFT_CliParam
{
	Description = "This parameter is used to force the defrag even if free space on the disk is low.";
	ParaId = "Force";
	Qualifiers = {
instance of MSFT_CliQualifier
{
	Name = "In";
	QualifierValue = {"True"};
}};
	Type = "BOOLEAN";
}, 
instance of MSFT_CliParam
{
	Description = "This parameter is a Win32_DefragAnalysis object that contains properties describing the extent to which the volume is fragmented.";
	ParaId = "DefragAnalysis";
	Qualifiers = {
instance of MSFT_CliQualifier
{
	Name = "Out";
	QualifierValue = {"True"};
}};
	Type = "OBJECT";
}};
	Qualifiers = {
instance of MSFT_CliQualifier
{
	Name = "Values";
	QualifierValue = {"Success", "Access denied", "Not supported", "Volume dirty bit is set", "Not enough free space", "Corrupt Master File Table detected", "Call Cancelled", "Call cancellation request too late", "Defrag engine is already running", "Unable to connect to defrag engine", "Defrag engine error", "Unknown error"};
}};
	Usage = "Defrag";
}, 
instance of MSFT_CliVerb
{
	Derivation = "DefragAnalysis";
	Description = "This method is used to generate a defrag analysis for the volume.";
	Name = "DefragAnalysis";
	Parameters = {
instance of MSFT_CliParam
{
	Description = "This parameter is a Win32_DefragAnalysis object that contains properties describing the extent to which the volume is fragmented.";
	ParaId = "DefragAnalysis";
	Qualifiers = {
instance of MSFT_CliQualifier
{
	Name = "Out";
	QualifierValue = {"True"};
}};
	Type = "OBJECT";
}, 
instance of MSFT_CliParam
{
	Description = "This parameter indicates whether defragmentation or the volume is recommended.";
	ParaId = "DefragRecommended";
	Qualifiers = {
instance of MSFT_CliQualifier
{
	Name = "Out";
	QualifierValue = {"True"};
}};
	Type = "BOOLEAN";
}};
	Qualifiers = {
instance of MSFT_CliQualifier
{
	Name = "Values";
	QualifierValue = {"Success", "Access denied", "Not supported", "Volume dirty bit is set", "Not enough free space", "Corrupt Master File Table detected", "Call Cancelled", "Call cancellation request too late", "Defrag engine is already running", "Unable to connect to defrag engine", "Defrag engine error", "Unknown error"};
}};
	Usage = "DefragAnalysis";
}, 
instance of MSFT_CliVerb
{
	Derivation = "AddMountPoint";
	Description = "This method is used to add a mount point directory for the volume.  The result of this method is the creation of a Win32_MountPoint class associating this volume with the Win32_Directory instance representing the directory specified in the parameter list";
	Name = "AddMountPoint";
	Parameters = {
instance of MSFT_CliParam
{
	Description = "This parameter is the directory where the volume is to be mounted.";
	ParaId = "Directory";
	Qualifiers = {
instance of MSFT_CliQualifier
{
	Name = "In";
	QualifierValue = {"True"};
}};
	Type = "STRING";
}};
	Qualifiers = {
instance of MSFT_CliQualifier
{
	Name = "Values";
	QualifierValue = {"Success", "Access denied", "Invalid argument", "Specified directory not empty", "Specified directory not found", "Volume mount points not supported", "Unknown error"};
}};
	Usage = "AddMountPoint";
}, 
instance of MSFT_CliVerb
{
	Derivation = "Mount";
	Description = "This method is used to mount a volume to the file system.";
	Name = "Mount";
	Qualifiers = {
instance of MSFT_CliQualifier
{
	Name = "Values";
	QualifierValue = {"Success", "Access Denied", "Unknown error"};
}};
	Usage = "Mount";
}, 
instance of MSFT_CliVerb
{
	Derivation = "Dismount";
	Description = "This method is used to dismount a volume from the file system.";
	Name = "Dismount";
	Parameters = {
instance of MSFT_CliParam
{
	Description = "This parameter indicates whether the volume should be forced to dismount if open handles exist.";
	ParaId = "Force";
	Qualifiers = {
instance of MSFT_CliQualifier
{
	Name = "In";
	QualifierValue = {"True"};
}};
	Type = "BOOLEAN";
}, 
instance of MSFT_CliParam
{
	Description = "This parameter indicates whether the volume should be dismounted to a no-automount (offline) state. The volume may be returned to the automount state by explicitly calling the Mount method or creating a mount point for the volume.";
	ParaId = "Permanent";
	Qualifiers = {
instance of MSFT_CliQualifier
{
	Name = "In";
	QualifierValue = {"True"};
}};
	Type = "BOOLEAN";
}};
	Qualifiers = {
instance of MSFT_CliQualifier
{
	Name = "Values";
	QualifierValue = {"Success", "Access denied", "Volume has mount points", "Volume does not support the no-automount state", "Force option requiredUnknown error"};
}};
	Usage = "Dismount";
}};
};


