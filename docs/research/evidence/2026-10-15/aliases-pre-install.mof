instance of MSFT_CliQualifier
{
	Name = "MaxLen";
	QualifierValue = {"10"};
}, 
instance of MSFT_CliQualifier
{
	Name = "ValueMap";
	QualifierValue = {"OK", "Error", "Degraded", "Unknown", "Pred Fail", "Starting", "Stopping", "Service"};
}, 
instance of MSFT_CliQualifier
{
	Name = "Values";
	QualifierValue = {"OK", "Error", "Degraded", "Unknown", "Pred Fail", "Starting", "Stopping", "Service"};
}};
}, 
instance of MSFT_CliProperty
{
	Derivation = "TransferWidths";
	Description = "An array indicating all the transfer widths (in bits) supported by this DMA channel.  If unknown, enter 0.";
	Name = "TransferWidths";
}, 
instance of MSFT_CliProperty
{
