	Name = "AutomaticResetBootOption";
}, 
instance of MSFT_CliProperty
{
	Derivation = "AutomaticResetCapability";
	Description = "The AutomaticResetCapability property determines whether the automatic reset is enabled. This capability is available on Windows NT but not on Windows 95./nValues: TRUE or FALSE. If TRUE, the automatic reset is enabled.";
	Name = "AutomaticResetCapability";
}, 
instance of MSFT_CliProperty
{
	Derivation = "BootOptionOnLimit";
