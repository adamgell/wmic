	Name = "__GENUS";
}, 
instance of MSFT_CliProperty
{
	Derivation = "__NAMESPACE";
	Name = "__NAMESPACE";
}, 
instance of MSFT_CliProperty
{
	Derivation = "__PATH";
	Name = "__PATH";
}, 
instance of MSFT_CliProperty
{
