	Name = "Label";
}, 
instance of MSFT_CliProperty
{
	Derivation = "Name";
	Description = "The Name property defines the label by which the object is known. When subclassed, the Name property can be overridden to be a Key property.";
	Name = "Name";
}};
}, 
instance of MSFT_CliFormat
{
	Name = "FULL";
	Properties = {
instance of MSFT_CliProperty
{
	Derivation = "Automount";
	Description = "If TRUE, the Automount property indicates that the volume will be mounted to the file system automatically when the first I/O is issued. Otherwise it will not be mounted until explicitly mounted with the Mount method or by adding a drive letter or mount point.";
	Name = "Auto Mount Enabled";
}, 
instance of MSFT_CliProperty
{
	Derivation = "BlockSize";
	Name = "BlockSize";
}, 
instance of MSFT_CliProperty
{
	Derivation = "Capacity";
	Description = "The Capacity property indicates in bytes, the size of the volume.";
	Name = "Capacity";
}, 
instance of MSFT_CliProperty
{
	Derivation = "Compressed";
	Description = "If TRUE, the volume exists as a single compressed entity, such as a DoubleSpace volume.If file based compression is supported (such as on NTFS), this property will be FALSE.";
	Name = "Compressed";
}, 
instance of MSFT_CliProperty
{
	Derivation = "DeviceID";
	Description = "The DeviceID property contains a string uniquely identifying the volume on the system.";
	Name = "ID";
}, 
instance of MSFT_CliProperty
{
	Derivation = "DirtyBitSet";
	Description = "Indicates if the ChkDsk method should be run at next boot up.";
	Name = "Dirty Bit Set";
}, 
instance of MSFT_CliProperty
{
	Derivation = "DriveLetter";
	Description = "The DriveLetter property indicates the drive letter assigned to the volume. This property is NULL for volumes without drive letters.";
	Name = "Drive Letter";
}, 
instance of MSFT_CliProperty
{
	Derivation = "DriveType";
	Description = "The DriveType property contains a numeric value corresponding to the type of disk drive this logical disk represents.  Please refer to the Platform SDK documentation for additional values./nExample: A CD-ROM drive would return 5.";
	Name = "DriveType";
	Qualifiers = {
instance of MSFT_CliQualifier
{
	Name = "Values";
	QualifierValue = {"Unknown", "No Root Directory", "Removable Disk", "Local Disk", "Network Drive", "Compact Disc", "RAM Disk"};
}};
}, 
instance of MSFT_CliProperty
{
	Derivation = "FileSystem";
	Description = "The FileSystem property indicates the file system on the logical disk. Example: NTFS";
	Name = "File System";
}, 
instance of MSFT_CliProperty
{
	Derivation = "FreeSpace";
	Description = "The FreeSpace property indicates in bytes how much free space is available on the volume.";
	Name = "Free Space";
}, 
instance of MSFT_CliProperty
{
	Derivation = "IndexingEnabled";
	Description = "If context indexing is enabled this property will be TRUE";
	Name = "Indexing Enabled";
}, 
instance of MSFT_CliProperty
{
	Derivation = "Label";
	Description = "The Label property indicates the volume name of the logical disk. Constraints: Maximum 32 characters. This property is NULL for a volume without a label.";
	Name = "Label";
}, 
instance of MSFT_CliProperty
{
	Derivation = "MaximumFileNameLength";
	Description = "Maximum length of a filename component supported by the Windows drive. A filename component is that portion of a filename between backslashes. The value can be used to indicate that long names are supported by the specified file system. For example, for a FAT file system supporting long names, the function stores the value 255, rather than the previous 8.3 indicator. Long names can also be supported on systems that use the NTFS file system. Example: 255";
	Name = "Maximum File Name Length";
}, 
instance of MSFT_CliProperty
{
	Derivation = "Name";
	Description = "The Name property defines the label by which the object is known. When subclassed, the Name property can be overridden to be a Key property.";
	Name = "Name";
}, 
instance of MSFT_CliProperty
{
	Derivation = "QuotasEnabled";
	Description = "The QuotasEnabled property indicates that quota management is enabled for this volume.";
	Name = "Quotas Enabled";
}, 
instance of MSFT_CliProperty
{
	Derivation = "QuotasIncomplete";
	Description = "The QuotasIncomplete property indicates that quota management was used but has been disabled. Incomplete refers to the information left in the file system after quota management was disabled.";
	Name = "Quotas Incomplete";
}, 
instance of MSFT_CliProperty
{
	Derivation = "QuotasRebuilding";
	Description = "The QuotasRebuilding property indicates that the file system is in the active process of compiling information and setting the disk up for quota management.";
	Name = "Quotas Rebuilding";
}, 
instance of MSFT_CliProperty
{
	Derivation = "SerialNumber";
	Description = "The SerialNumber property indicates the serial number of the volume. Constraints: Maximum 11 characters. Example: A8C3-D032";
	Name = "Serial Number";
}, 
instance of MSFT_CliProperty
{
	Derivation = "SupportsDiskQuotas";
	Description = "The SupportsDiskQuotas property indicates if the volume supports disk quotas.";
	Name = "Supports Disk Quotas";
}, 
instance of MSFT_CliProperty
{
	Derivation = "SupportsFileBasedCompression";
	Description = "The SupportsFileBasedCompression property indicates if the volume supports file based compression as is the case with the NTFS file system.";
	Name = "Supports File Based Compression";
}, 
instance of MSFT_CliProperty
{
	Derivation = "SystemName";
	Name = "SystemName";
}};
