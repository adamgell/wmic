instance of MSFT_CliParam
{
	Description = "The Recursive input parameter is a boolean that indicates whether the change of ownership will be applied recursively to files and directories within the directory specified by the CIM_LogicalFile instance.Note for file instances the Recursive input parameter is ignored.";
