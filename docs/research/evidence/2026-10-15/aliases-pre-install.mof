	QualifierValue = {"X86-based PC", "MIPS-based PC", "Alpha-based PC", "Power PC", "SH-x PC", "StrongARM PC", "64-bit Intel PC", "64-bit Alpha PC", "Unknown", "X86-Nec98 PC"};
