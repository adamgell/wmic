	QualifierValue = {"The JoinDomainOrWorkgroup method joins computer systems to a domain or workgroup.  This method is only available on Windows 2000 platforms and beyond. The method can return the following values:/n0 - Success./nOther - For integer values other than those lis"};
}, 
