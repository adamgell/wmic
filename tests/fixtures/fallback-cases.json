      "operation": "read_only",
      "timeout_ms": 10000
    },
    {
      "id": "fallback-null",
      "arguments": "alias where \"PWhere IS NULL AND FriendlyName LIKE 'O%'\" get FriendlyName",
      "operation": "read_only",
      "timeout_ms": 10000
    },
    {
      "id": "fallback-not",
      "arguments": "alias where \"NOT (FriendlyName LIKE '%S%') AND FriendlyName='CPU'\" get FriendlyName",
      "operation": "read_only",
      "timeout_ms": 10000
    },
    {
      "id": "fallback-brackets",
