			[IN ]DaysOfMonth(UINT32)            	

			[IN ]DaysOfWeek(UINT32)             	

			[IN ]InteractWithDesktop(BOOLEAN)   	

			[IN ]RunRepeatedly(BOOLEAN)         	

			[IN ]StartTime(DATETIME)            	

			[OUT]JobId(UINT32)                  	

Delete                  					(null)         



